# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Agro-Capital FastAPI Backend
# Copier ce fichier en .env et remplir les valeurs réelles.
# Ne JAMAIS committer .env dans Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données Supabase (lecture seule) ──────────────────────────────────
# Format : postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# Supabase : utiliser de préférence un rôle lecture seule (voir dashboard Supabase)
# Connection pooler (Supavisor) recommandé pour serverless — port 6543 :
#   postgresql+asyncpg://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Connexion directe — port 5432 :
#   postgresql+asyncpg://postgres:PASSWORD@db.REF.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres

# ── LLM Google Gemini ─────────────────────────────────────────────────────────
# Clé API gratuite : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── CORS — Domaine(s) du frontend Next.js ────────────────────────────────────
# Séparés par des virgules si plusieurs origines
ALLOWED_ORIGINS=http://localhost:3000,https://agrocapital.vercel.app

# ── Cache des prédictions (en secondes) ──────────────────────────────────────
# 1800 = 30 minutes
PREDICTION_CACHE_TTL=1800
